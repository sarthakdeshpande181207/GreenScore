{
    "version": 2,
    "builds": [
        {
            "src": "index.html",
            "use": "@vercel/static"
        },
        {
            "src": "api/aqi.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/aqi",
            "dest": "/api/aqi.js"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}